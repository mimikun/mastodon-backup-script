[Unit]
Description=Mastodon Database Backup Service
Documentation=https://github.com/mimikun/mastodon-backup-script
After=network.target postgresql.service redis.service
Requires=postgresql.service redis.service

[Service]
Type=oneshot
User=postgres
Group=postgres
WorkingDirectory=/var/lib/postgresql/mastodon-backup-script

# Execute backup script
ExecStart=/bin/bash /var/lib/postgresql/mastodon-backup-script/backup.sh

# Restart policy (no restart for oneshot services)
Restart=no

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/postgresql/backups

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mastodon-backup

[Install]
WantedBy=multi-user.target

