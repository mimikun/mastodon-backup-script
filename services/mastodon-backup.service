[Unit]
Description=Mastodon Database Backup Service
Documentation=https://github.com/mimikun/mastodon-backup-script
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=oneshot
User=mastodon
Group=mastodon
WorkingDirectory=/home/mastodon/mastodon-backup-script

# Execute backup script
ExecStart=/home/mastodon/mastodon-backup-script/backup.sh

# Restart policy (no restart for oneshot services)
Restart=no

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mastodon/backups

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mastodon-backup

[Install]
WantedBy=multi-user.target

